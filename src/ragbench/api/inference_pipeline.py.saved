from abc import ABC, abstractmethod
from typing import Generic, TypeVar

from pydantic import BaseModel
from rag_unitxt_cards.data_models.rag_benchmark import RagBenchmark
from rageval.pipeline.api.data_model import (
    DataPipelineOutput,
    InferencePipelineOutput,
    RuntimeParams,
)

T = TypeVar("T", bound=BaseModel)


class InferencePipeline(ABC, Generic[T]):
    def __init__(self, pipeline_params: T, runtime_params: RuntimeParams):
        self.pipeline_params = pipeline_params
        self.runtime_params = runtime_params

    @abstractmethod
    def process(
        self, rag_benchmark: RagBenchmark, data_pipeline_output: DataPipelineOutput
    ) -> InferencePipelineOutput:
        pass

    def get_description(self) -> dict:
        return {
            "type": self.__class__.__name__,
            "params": self.pipeline_params.model_dump(),
        }

    @abstractmethod
    def restrict_access_control(self, dataset_access_control: bool) -> bool:
        raise NotImplementedError()

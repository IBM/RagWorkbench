from abc import ABC, abstractmethod
from typing import Generic, TypeVar

from pydantic import BaseModel
from rag_unitxt_cards.data_models.rag_corpus import RagCorpus
from rageval.flows.dataset_id import DatasetID
from rageval.pipeline.api.data_model import DataPipelineOutput, RuntimeParams

T = TypeVar("T", bound=BaseModel)


class DataPipeline(ABC, Generic[T]):
    def __init__(
        self, pipeline_params: T, runtime_params: RuntimeParams, drop_index: bool
    ):
        self.pipeline_params = pipeline_params
        self.runtime_params = runtime_params
        self.drop_index = drop_index

    @abstractmethod
    def process(
        self, rag_corpus: RagCorpus, dataset_id: DatasetID
    ) -> DataPipelineOutput:
        pass

    def get_description(self) -> dict:
        return {
            "type": self.__class__.__name__,
            "params": self.pipeline_params.model_dump(),
        }

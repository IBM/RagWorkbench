# Simple RAG Pipeline Environment Variables

# LiteLLM API Keys
# Set the appropriate API key for your LLM provider
# See: https://docs.litellm.ai/docs/providers

# OpenAI (for models like gpt-3.5-turbo, gpt-4, text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL (optional)
# Use this to point to a LiteLLM proxy server or other OpenAI-compatible endpoint
# Default: https://api.openai.com/v1
# OPENAI_API_BASE=http://localhost:4001/
